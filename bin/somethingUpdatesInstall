#!/bin/bash source-this-script
set -o pipefail

: ${SOMETHING_PACKAGE_AND_VERSION_SEPARATOR:=[[:space:]:]}
: ${SOMETHING_AVAILABLE_VERSION_SEPARATOR:=[	 ]}

readonly scriptName="$(basename -- "$0")"

: ${SUDO:=sudoWithUnixhome}; [ $EUID -eq ${SOMETHING_UID:-0} ] && SUDO=''	# Need superuser rights for updating the ignore list.

printUsage()
{
    cat <<HELPTEXT
Offers to update $SOMETHING_SUBJECT_NAME packages that are outdated, and memorizes the
choices for future runs. Exits with 99 if all packages are up-to-date.
HELPTEXT
    echo
    printf 'Usage: %s%q [--preserve-env=DEBUG] %s\n' "$scriptName" "${SUDO}${SUDO:+ }" "$(basename "$1")" '[-?|-h|--help]'
}
case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac

hasUpdatesAvailableCommand=
if [ -n "$SOMETHING_SOURCE_COMMANDLINE" ]; then
    sourceCommandLine="$SOMETHING_SOURCE_COMMANDLINE"
elif type -t "${SOMETHING_SUBJECT}-updates-available" >/dev/null ; then
    sourceCommandLine="${SOMETHING_SUBJECT}-updates-available --terse"
    hasUpdatesAvailableCommand=t
elif type -t "${SOMETHING_SUBJECT}-list-outdated" >/dev/null; then
    sourceCommandLine="${SOMETHING_SUBJECT}-list-outdated | field 1"
else
    echo >&2 'ASSERT: No source command configured; set SOMETHING_SOURCE_COMMANDLINE first.'; exit 3
fi
[ ! "$hasUpdatesAvailableCommand" ] && type -t "${SOMETHING_SUBJECT}-updates-available" >/dev/null && hasUpdatesAvailableCommand=t


runSourceCommandLine()
{
    local sourceCommandLine="${1:?}"; shift
    invocationMessage --or-passthrough --clear all --message 'Checking for outdated packages ' --initial-delay 2s --spinner --render-timer 1s --command \
	    "$sourceCommandLine"
}

readarray -t packageNames < <(runSourceCommandLine "$sourceCommandLine")
[ ${#packageNames[@]} -eq 0 ] && exit 99
if [ -n "$SOMETHING_SOURCE_OUTDATED_COMMANDLINE" ]; then
    # SOMETHING supplies a separate command for getting the full info, so use that.
    readarray -t originalOutdatedPackageNames < <(runSourceCommandLine "$SOMETHING_SOURCE_OUTDATED_COMMANDLINE")
    originalOutdatedPackageNames=("${originalOutdatedPackageNames[@]%%${SOMETHING_PACKAGE_AND_VERSION_SEPARATOR}*}")
else
    typeset -a originalOutdatedPackageNames=("${packageNames[@]}")
fi

packageNamesPlural=s; [ ${#packageNames[@]} -eq 1 ] && packageNamesPlural=
printf >&2 '%d package%s can be updated.\n' "${#packageNames[@]}" "$packageNamesPlural"


if [ ! $EUID ${SOMETHING_USER_COMPAREOP:--eq} ${SOMETHING_UID:-0} ]; then
    echo "ERROR: Must have ${SOMETHING_UID:+UID }${SOMETHING_UID:-superuser rights} to update system packages."
    exit 2
fi

askTo()
{
    memoizeDecision --memoize-group "$scriptName" --verb 'is' --state 'outdated' --action 'update it' "$@"
}

getInstalledPackageInfo()
{
    local sourceCommandLineWithFullInfo
    if [ -n "$SOMETHING_SOURCE_OUTDATED_COMMANDLINE" ]; then
	# SOMETHING supplies a separate command for getting the full info, so use that.
	sourceCommandLineWithFullInfo="$SOMETHING_SOURCE_OUTDATED_COMMANDLINE"
    else
	# Try to get the full info about installed packages, i.e. including the
	# installed and available versions; we might need the latter for ignoring a
	# specific version, and the lookup may be costly.
	sourceCommandLineWithFullInfo="${sourceCommandLine:?}"
	sourceCommandLineWithFullInfo="${sourceCommandLineWithFullInfo//' --terse'/}"
	sourceCommandLineWithFullInfo="${sourceCommandLineWithFullInfo//' | field 1'/}"
    fi

    runSourceCommandLine "$sourceCommandLineWithFullInfo"
}

checkUpdate()
{
    typeset -a outdatedPackageNames; readarray -t outdatedPackageNames < <(getInstalledPackageInfo)
    # Extract the package names in field 1; the normal format may include a colon
    # after the package name.
    outdatedPackageNames=("${outdatedPackageNames[@]%%${SOMETHING_PACKAGE_AND_VERSION_SEPARATOR}*}")
    [ ${#outdatedPackageNames[@]} -gt 0 ] || return 0

    typeset -a packageNamesNotUpToDate; readarray -t packageNamesNotUpToDate < \
	<(comm -12 \
	    <(printf '%s\n' "${originalOutdatedPackageNames[@]}" | sort) \
	    <(printf '%s\n' "${outdatedPackageNames[@]}" | sort)
	)
    [ ${#packageNamesNotUpToDate[@]} -gt 0 ] || return 0

    typeset -a packageNamesThatShouldHaveBeenUpdated=()
    local packageName; for packageName in "${packageNamesNotUpToDate[@]}"
    do
	askTo --recall-only --default yes --subject "$packageName" >/dev/null 2>&1 \
	    && packageNamesThatShouldHaveBeenUpdated+=("$packageName")
    done
    [ ${#packageNamesThatShouldHaveBeenUpdated[@]} -gt 0 ] || return 0

    case "${SOMETHING_FAILED_UPDATE_ACTION:-ask}" in
	suppress)
	    ;;
	warn)
	    printMessageAboutPackagesThatShouldHaveBeenUpdated Warning '' "${packageNamesThatShouldHaveBeenUpdated[@]}";;
	ask)
	    printMessageAboutPackagesThatShouldHaveBeenUpdated Warning '' "${packageNamesThatShouldHaveBeenUpdated[@]}"

	    typeset -a choices=('[S]kip and try again next time' '[T]ry again now')
	    [ "$hasUpdatesAvailableCommand" ] && choices+=('Ignore currently offered [v]ersion' 'Ignore [e]ntered version pattern' 'Ignore [p]ackage (all versions)')

	    local packageName choice
	    for packageName in "${packageNamesThatShouldHaveBeenUpdated[@]}"
	    do
		{ echo >/dev/tty; } 2>/dev/null
		choice="$(userchoiceFromList --keep-prompt --question "$packageName" --ignore-case -- "${choices[@]}")"; choiceStatus=$?
		case $choiceStatus in
		    0)	    ;;
		    99|125) break;;
		    *)	    exit 3;;
		esac
		case "$choice" in
		    'Skip and try again next time')
			;;
		    'Try again now')
			${DEBUG:+debugcommand  --for "$scriptName" --eval --} eval "${SOMETHING_UPDATE_COMMAND:?}" '"$packageName"' || status=$?;;
		    'Ignore currently offered version')
			ignoreVersion "$packageName";;
		    'Ignore entered version pattern')
			ignoreEnteredVersion "$packageName";;
		    'Ignore package (all versions)')
			ignorePackage "$packageName";;
		    *)  printf >&2 'ASSERT: Unhandled choice: %s\n' "$choice"; exit 3;;
		esac
	    done
	    ;;
	ignore-version)
	    printMessageAboutPackagesThatShouldHaveBeenUpdated Note 'Ignoring particular version of' "${packageNamesThatShouldHaveBeenUpdated[@]}"
	    local packageName; for packageName in "${packageNamesThatShouldHaveBeenUpdated[@]}"
	    do
		ignoreVersion "$packageName"
	    done
	    ;;
	ignore-package)
	    printMessageAboutPackagesThatShouldHaveBeenUpdated Note 'Ignoring all versions of' "${packageNamesThatShouldHaveBeenUpdated[@]}"
	    local packageName; for packageName in "${packageNamesThatShouldHaveBeenUpdated[@]}"
	    do
		ignorePackage "$packageName"
	    done
	    ;;
	*)  printf >&2 'ASSERT: Invalid SOMETHING_FAILED_UPDATE_ACTION: %s\n' "$SOMETHING_FAILED_UPDATE_ACTION"; exit 3;;
    esac
}

printMessageAboutPackagesThatShouldHaveBeenUpdated()
{
    local severity="${1:?}"; shift
    local verb="${1?}"; shift

    if [ $# -eq 1 ]; then
	local packageNamesPlural=
	local packageNamesAuxiliaryVerb=is
    else
	local packageNamesPlural=s
	local packageNamesAuxiliaryVerb=are
    fi
    printf >&2 '\n%s: %s%d package%s %sshould have been updated, but %s still outdated:\n%s\n' \
	"$severity" "${verb}${verb:+ }" $# "$packageNamesPlural" "${verb:+that }" "$packageNamesAuxiliaryVerb" \
	"$(joinBy ', ' "$@")"
}

addIgnorePattern()
{
    "${SOMETHING_SUBJECT}-updates-available" --ignore "$@" \
	|| printf >&2 'ERROR: Failed to add ignore pattern for %s.\n' "$1"
}

ignorePackage()
{
    local packageName="${1:?}"; shift
    local literalPackagePattern; literalPackagePattern="$(toLiteralRegexp --extended-regexp "$packageName")" || exit 3
    addIgnorePattern "${literalPackagePattern:?}" \
	&& printf 'Put %s onto the ignore list. Use $ %q --no-ignore %q⏎ to unignore.\n' "$packageName" "${SOMETHING_SUBJECT}-updates-available" "$literalPackagePattern"
}

getPackageVersion()
{
    local packageName="${1:?}"; shift
    local literalPackagePattern="${1:?}"; shift
    local packageVersion; packageVersion="$(getInstalledPackageInfo | grep -E "^${literalPackagePattern}${SOMETHING_PACKAGE_AND_VERSION_SEPARATOR}")" \
	&& printf %s "${packageVersion##*${SOMETHING_AVAILABLE_VERSION_SEPARATOR}}"
}

ignoreVersion()
{
    local packageName="${1:?}"; shift
    local literalPackagePattern; literalPackagePattern="$(toLiteralRegexp --extended-regexp "$packageName")" || exit 3
    local packageVersion; packageVersion="$(getPackageVersion "$packageName" "$literalPackagePattern")" \
	&& addIgnorePattern "${literalPackagePattern:?}" --version "${packageVersion:?}" \
	&& printf 'Put %s version %s onto the ignore list. Use $ %q --no-ignore %q⏎ to unignore.\n' "$packageName" "$packageVersion" "${SOMETHING_SUBJECT}-updates-available" "$literalPackagePattern" \
	|| printf >&2 "ERROR: Failed to ignore the ${packageVersion:-unresolved} version of %s.\n" "$packageName"
}

ignoreEnteredVersion()
{
    local packageName="${1:?}"; shift
    local literalPackagePattern; literalPackagePattern="$(toLiteralRegexp --extended-regexp "$packageName")" || exit 3
    local packageVersion; packageVersion="$(getPackageVersion "$packageName" "$literalPackagePattern" | toLiteralRegexp --extended-regexp)"
    packageVersion="$(userquery -p "$packageName version pattern (anchored extended regexp; .* for all versions): " -r -e -i "$packageVersion")" \
	&& [ -n '$packageVersion' ] \
	&& addIgnorePattern "${literalPackagePattern:?}" --version "${packageVersion:?}" \
	&& printf 'Put %s version-pattern %s onto the ignore list. Use $ %q --no-ignore %q⏎ to unignore.\n' "$packageName" "$packageVersion" "${SOMETHING_SUBJECT}-updates-available" "$literalPackagePattern"
}


status=0
typeset -a selectedPackages=()
for packageName in "${packageNames[@]}"
do
    if askTo --subject "$packageName"; then
	if [ "$SOMETHING_SPECIAL_DEFINITIONS" ] && specialInstallCommandLine="$(setup-software --silence-no-definitions --yes --select "$packageName" "$SOMETHING_SPECIAL_DEFINITIONS")"; then
	    ${DEBUG:+debugcommand  --for "$scriptName" --eval --} eval "$specialInstallCommandLine" || { status=$?; continue; }	# Don't try to update this package if its special install instructions have failed.
	fi

	selectedPackages+=("$packageName")
    elif [ "$hasUpdatesAvailableCommand" ]; then
	# Check whether the user's reply was persistently negative, and then
	# forward this decision to ${SOMETHING_SUBJECT}-updates-available's
	# ignore list, so that the package will also be ignored when
	# update-${SOMETHING_SUBJECT}-updates-available updates the notification
	# shown in MOTD / sent via email.
	[[ "$(askTo --subject "$packageName" --get-decision)" =~ ^?(none-)never$ ]] \
	    && ignorePackage "$packageName"
    fi
done

[ ${#selectedPackages[@]} -eq 0 ] && exit 1

${DEBUG:+debugcommand  --for "$scriptName" --eval --} eval "${SOMETHING_UPDATE_COMMAND:?}" '"${selectedPackages[@]}"' || status=$?

[ "$SOMETHING_NO_CHECK_UPDATE" ] || checkUpdate

exit $status
